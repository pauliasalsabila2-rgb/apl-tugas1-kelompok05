        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml B3-Struktur-Alokasi\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam rectangle {\n    RoundCorner 8\n}\n\ntitle STRUKTUR ALOKASI: Penempatan Perangkat Lunak dan Penugasan Tim\ncaption Layanan Presensi Kuliah (Attendance Management - Kelompok I-5)\n\n&#39; Lingkungan Fisik / Deployment\npackage \&quot;Perangkat Pengguna\&quot; #D1ECF1 {\n    rectangle \&quot;Browser / Mobile App\\n(Mahasiswa &amp; Dosen)\&quot; as Klien\n}\n\npackage \&quot;Server Aplikasi Presensi (Cloud Kampus)\&quot; #E2E3E5 {\n    rectangle \&quot;Server Web Presensi\&quot; as WebServer\n    rectangle \&quot;Cache (Redis)\&quot; as Cache\n    rectangle \&quot;Antrean Pesan (RabbitMQ)\&quot; as Queue\n    rectangle \&quot;Worker Presensi\&quot; as Worker\n}\n\npackage \&quot;Server Data Kampus\&quot; #F8D7DA {\n    rectangle \&quot;Basis Data Akademik\\n(SIAKAD UMI)\&quot; as Database\n}\n\n&#39; Hubungan jaringan antar lingkungan\nKlien --&gt; WebServer : HTTPS\nWebServer --&gt; Database : SQL\n\n&#39; Penugasan Modul ke Tim / Anggota Kelompok (Alokasi Kerja)\npackage \&quot;Penugasan Modul ke Anggota Tim Kelompok I-5\&quot; #FFF3CD {\n    rectangle \&quot;Tim A\\n(Halaman Absen &amp; Panel Dosen)\&quot; as TimA\n    rectangle \&quot;Tim B\\n(Validasi GPS &amp; QR Dinamis)\&quot; as TimB\n    rectangle \&quot;Tim C\\n(Repositori &amp; Integrasi SIAKAD)\&quot; as TimC\n    rectangle \&quot;Tim D\\n(Uji Beban &amp; Pemantauan Server)\&quot; as TimD\n}\n\n&#39; Keterangan diagram\nnote bottom\n  &lt;b&gt;Cara Membaca:&lt;/b&gt;\n  Struktur alokasi menjawab dua hal: \&quot;di mana perangkat lunak berjalan?\&quot; (lingkungan perangkat, \n  server aplikasi cloud kampus, dan server data kampus) serta \&quot;siapa yang membuat tiap bagiannya?\&quot; \n  (penugasan modul ke anggota tim pengembang).\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="j9yi5dx_YiFyYRFAR-g7-1">
