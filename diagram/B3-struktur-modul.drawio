        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml B3-Struktur-Modul\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam rectangle {\n    RoundCorner 8\n}\nskinparam packageStyle rectangle\n\ntitle STRUKTUR MODUL: Unit Kode dan Hubungan \&quot;Menggunakan\&quot;\ncaption Layanan Presensi Kuliah (Attendance Management - Kelompok I-5)\n\n&#39; Lapisan Tampilan (UI Layer)\npackage \&quot;Lapisan Tampilan (UI)\&quot; #E2E3E5 {\n    rectangle \&quot;Halaman Presensi Mahasiswa\&quot; as HalamanAbsen\n    rectangle \&quot;Panel Sesi Dosen\&quot; as PanelDosen\n    rectangle \&quot;Laporan &amp; Rekapitulasi\&quot; as PanelLaporan\n}\n\n&#39; Lapisan Logika Koordinasi (Coordination Layer)\npackage \&quot;Lapisan Logika (Koordinasi)\&quot; #D1ECF1 {\n    rectangle \&quot;Pengelola Sesi &amp; Absensi\&quot; as PengelolaAbsen\n}\n\n&#39; Lapisan Aturan Bisnis (Business Rules Layer)\npackage \&quot;Lapisan Logika (Aturan Bisnis)\&quot; #FFF3CD {\n    rectangle \&quot;Validasi Geofencing &amp; GPS\&quot; as ValidasiGPS\n    rectangle \&quot;Verifikasi QR Dinamis\&quot; as VerifikasiQR\n    rectangle \&quot;Validasi Waktu &amp; Jadwal\&quot; as ValidasiJadwal\n}\n\n&#39; Lapisan Data (Data Layer)\npackage \&quot;Lapisan Data\&quot; #F8D7DA {\n    rectangle \&quot;Repositori Presensi\&quot; as RepoPresensi\n    rectangle \&quot;Repositori Akademik (SIAKAD)\&quot; as RepoAkademik\n}\n\n&#39; Hubungan / Arah Panah \&quot;Menggunakan\&quot; (A menggunakan B)\nHalamanAbsen --&gt; PengelolaAbsen\nPanelDosen --&gt; PengelolaAbsen\nPanelLaporan --&gt; PengelolaAbsen\n\nPengelolaAbsen --&gt; ValidasiGPS\nPengelolaAbsen --&gt; VerifikasiQR\nPengelolaAbsen --&gt; ValidasiJadwal\n\nValidasiGPS --&gt; RepoPresensi\nVerifikasiQR --&gt; RepoPresensi\nValidasiJadwal --&gt; RepoAkademik\nRepoPresensi --&gt; RepoAkademik\n\nnote bottom\n  &lt;b&gt;Aturan Lapisan:&lt;/b&gt;\n  Panah A → B berarti \&quot;modul A menggunakan modul B\&quot;.\n  Arah panah bersifat satu arah ke bawah (tidak boleh naik ke lapisan di atasnya).\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Lm3BwDnH_CyxNvRrxKT--1">
